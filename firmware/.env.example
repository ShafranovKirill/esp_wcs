# Заводские настройки ESP WCS.
#
# Скопируйте этот файл в .env (cp .env.example .env) и поменяйте значения.
# .env в git не попадает. Если .env нет, при сборке он создаётся из этого файла.
# После изменения .env достаточно `idf.py build` — значения перегенерируются.
#
# Пароль администратора в прошивку попадает только хэшем (PBKDF2-HMAC-SHA256
# со случайной солью), сам пароль во флеше не хранится.
# Пароль Wi-Fi хранится как есть — он нужен точке доступа в открытом виде.

# Точка доступа режима «Настройка». К префиксу добавляются 4 hex-цифры MAC: ESP-WCS-8580
WCS_SETUP_AP_SSID_PREFIX=ESP-WCS-
# WPA2/WPA3: от 8 до 63 символов
WCS_SETUP_AP_PASSWORD=adminadmin

# Вход в веб-интерфейс
WCS_ADMIN_USERNAME=admin
WCS_ADMIN_PASSWORD=admin

# Число итераций PBKDF2: больше — медленнее подбор, но дольше вход
WCS_PBKDF2_ITERATIONS=10000
