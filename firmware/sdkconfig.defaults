# Настройки по умолчанию для прошивки ESP WCS.
# База платы — docs/hardware/sdkconfig.defaults.n16r8 (проверено на ESP-IDF v6.1).
# sdkconfig генерируется из этого файла, вручную не редактировать и в git не коммитить.

# Плата: ESP32-S3-WROOM-1-N16R8
CONFIG_IDF_TARGET="esp32s3"

# Flash 16 МБ, режим QIO
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# PSRAM 8 МБ, Octal, 80 МГц
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Процессор 240 МГц
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Своя таблица разделов: два слота OTA, NVS с запасом под ключи и сертификаты
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Основная задача поднимает Wi-Fi и веб-сервер
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Браузеры присылают длинные заголовки
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
