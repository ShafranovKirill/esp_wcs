#!/usr/bin/env bash
set -euo pipefail
if [[ ${EUID} != 0 ]]; then
  echo 'Запустите через sudo: sudo scripts/setup-hotspot <Wi-Fi-интерфейс>' >&2
  exit 1
fi
wifi_interface=${1:?Укажите Wi-Fi-интерфейс, например wlp2s0}
[[ $wifi_interface =~ ^[a-zA-Z0-9_-]+$ ]] || exit 1
cd "$(dirname "$0")/.."
exec python3 - "$wifi_interface" <<'PY'
import pathlib
import subprocess
import sys

def run(*args):
    subprocess.run(args, check=True, stdout=subprocess.DEVNULL)

values = {}
for name in ('.env.example', '.env'):
    if not pathlib.Path(name).exists():
        continue
    for line in pathlib.Path(name).read_text().splitlines():
        if line.strip() and not line.lstrip().startswith('#') and '=' in line:
            key, value = line.split('=', 1)
            values[key.strip()] = value.strip().strip('\'"')
ssid = values['BASTION_HOTSPOT_SSID']
password = values['BASTION_HOTSPOT_PASSWORD']
if not 1 <= len(ssid.encode()) <= 32 or not 8 <= len(password) <= 63:
    sys.exit('Неверная длина SSID или пароля')
interface = sys.argv[1]
unit = f'''[Unit]
Description=ESP WCS virtual Wi-Fi access point interface
After=NetworkManager.service
Requires=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/iw dev {interface} interface add wcsap0 type __ap
ExecStop=/usr/sbin/iw dev wcsap0 del

[Install]
WantedBy=multi-user.target
'''
if not pathlib.Path('/usr/sbin/iw').exists():
    sys.exit('Установите iw')
unit_path = pathlib.Path('/etc/systemd/system/esp-wcs-hotspot-interface.service')
if unit_path.exists() and unit_path.read_text() != unit:
    sys.exit('Существующая служба отличается; проверьте её вручную')
unit_path.write_text(unit)
run('systemctl', 'daemon-reload')
run('systemctl', 'enable', '--now', 'esp-wcs-hotspot-interface.service')
profile = 'esp-wcs-bastion'
exists = subprocess.run(['nmcli', 'connection', 'show', profile], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
if not exists:
    run('nmcli', 'connection', 'add', 'type', 'wifi', 'ifname', 'wcsap0', 'con-name', profile, 'ssid', ssid)
run('nmcli', 'connection', 'modify', profile, 'connection.autoconnect', 'no',
    '802-11-wireless.ssid', ssid, '802-11-wireless.mode', 'ap', '802-11-wireless.band', 'bg',
    'wifi-sec.key-mgmt', 'wpa-psk', 'wifi-sec.psk', password,
    'ipv4.method', 'shared', 'ipv4.addresses', '10.42.0.1/24', 'ipv6.method', 'disabled')
port = int(values.get('BASTION_LINK_PORT', '7443'))
if not 1 <= port <= 65535:
    sys.exit('Неверный BASTION_LINK_PORT')
if subprocess.run(['systemctl', 'is-active', '--quiet', 'firewalld']).returncode == 0:
    rule = f'rule family="ipv4" source address="10.42.0.0/24" port port="{port}" protocol="tcp" accept'
    run('firewall-cmd', '--permanent', '--zone=nm-shared', '--add-rich-rule', rule)
    run('firewall-cmd', '--zone=nm-shared', '--add-rich-rule', rule)
print('Интерфейс, профиль и доступ к WCS Link готовы. Точка доступа пока выключена.')
PY
