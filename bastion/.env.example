# Настройки бастиона. Скопируйте в .env (cp .env.example .env) и поменяйте значения.
# .env в git не попадает. Переменные окружения важнее значений из файла.

# PostgreSQL (docker-compose.yml)
BASTION_DB_USER=bastion
BASTION_DB_PASSWORD=bastion
DATABASE_URL=ecto://bastion:bastion@localhost:5434/bastion_dev

# Администратор: в БД попадает только хэш (mix bastion.admin)
BASTION_ADMIN_USERNAME=admin
BASTION_ADMIN_PASSWORD=change-me

# Пароль закрытого ключа корневого сертификата. Потеря = регистрировать устройства заново
BASTION_CA_PASSPHRASE=change-me-too

# Дополнительные имена и IP для сертификата сервера, через запятую (домен сервера и т.п.)
BASTION_HOSTS=

# Порт WCS Link для устройств (в мастере ESP по умолчанию тоже 7443)
BASTION_LINK_PORT=7443

# Каталог ключей и сертификатов
BASTION_DATA_DIR=data

# Подпись cookie (prod): mix phx.gen.secret
SECRET_KEY_BASE=
